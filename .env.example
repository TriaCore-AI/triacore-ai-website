# Nieuwsbrief van de kennisbank (Resend): inschrijven (netlify/functions/newsletter-subscribe.js) en
# uitschrijven (newsletter-unsubscribe.js).
# Kopieer dit bestand naar .env (lokaal) of zet deze waarden in het Netlify-dashboard
# (Site settings -> Environment variables). Zet hier NOOIT echte sleutels in een commit.

# API-key uit het Resend-dashboard (Settings -> API Keys)
RESEND_API_KEY=

# ID van het segment (de nieuwsbrieflijst) in Resend (Audience -> Segments). Productie: "Kennisbank".
# Staging: een aparte testlijst ("TriaCore Test"), zodat testadressen niet op de echte lijst komen.
# De oude naam RESEND_AUDIENCE_ID werkt ook nog.
RESEND_SEGMENT_ID=

# Optioneel: eigen geheim voor de handtekening van de uitschrijflink in de welkomstmail (een lange willekeurige
# tekst). Zonder dit geldt de API-sleutel als geheim, zoals vroeger; een nieuwe sleutel maakt dan de links in
# eerder verstuurde welkomstmails ongeldig.
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Afzender van de welkomstmail. Het domein nieuws.triacore.be is in Resend enkel voor de nieuwsbrief (sinds
# 21/11/2026), los van app.triacore.be waarlangs klantmails (A&M, Croes) vertrekken, zodat die elkaars
# reputatie niet raken. Bv. TriaCore AI <kennisbank@nieuws.triacore.be>
NEWSLETTER_FROM=

# Optioneel: waar antwoorden op de welkomstmail naartoe gaan, bv. info@triacore.be
NEWSLETTER_REPLY_TO=

# Optioneel: waar links in mails en op de uitschrijfpagina naartoe wijzen (standaard https://triacore.be).
# Staging: https://triacore-staging.netlify.app. Lokaal met netlify dev: http://localhost:8888. In productie NIET zetten.
# NEWSLETTER_SITE_URL=http://localhost:8888
